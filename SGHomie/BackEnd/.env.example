# Local Edge Functions: supabase functions serve chatbot --env-file .env
# Hosted Edge Functions use Supabase secrets, not this local file.
CHAT_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_NAME=SG Homie
OPENROUTER_SITE_URL=http://localhost:5173

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
